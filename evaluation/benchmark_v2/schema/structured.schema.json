{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BenchmarkV2StructuredLabel",
  "type": "object",
  "required": ["balance_sheet", "income_statement", "cash_flow"],
  "properties": {
    "metadata": {
      "type": "object"
    },
    "balance_sheet": { "$ref": "#/$defs/statement" },
    "income_statement": { "$ref": "#/$defs/statement" },
    "cash_flow": { "$ref": "#/$defs/statement" }
  },
  "$defs": {
    "statement": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/item" }
        }
      }
    },
    "item": {
      "type": "object",
      "required": ["item_name"],
      "properties": {
        "item_code": { "type": ["string", "null"] },
        "item_name": { "type": "string" },
        "value": { "type": ["number", "null"] },
        "notes_ref": { "type": ["string", "null"] },
        "original_name": { "type": ["string", "null"] }
      }
    }
  }
}

